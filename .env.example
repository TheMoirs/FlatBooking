# Postgres connection string (Neon gives you this on the project dashboard)
# Use the "pooled connection" string Neon shows you, e.g.:
# postgresql://user:password@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of email addresses that should automatically become
# admins on sign-up (case-insensitive). These are the only accounts that can
# store the Google Calendar link and authorise bookings.
ADMIN_EMAILS=ali@themoirs.co.uk,dawn@themoirs.co.uk

# Port the server listens on. Render sets this for you automatically —
# you only need it for running locally.
PORT=3000
