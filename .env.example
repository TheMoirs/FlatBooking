# Postgres connection string (Neon gives you this on the project dashboard)
# Use the "pooled connection" string Neon shows you, e.g.:
# postgresql://user:password@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of email addresses that should automatically become
# admins on sign-up (case-insensitive). These are the only accounts that can
# store the Google Calendar link and authorise bookings.
ADMIN_EMAILS=ali@themoirs.co.uk,dawn@themoirs.co.uk

# Port the server listens on. Render sets this for you automatically —
# you only need it for running locally.
PORT=3000

# Optional Google Calendar write-back for bookings.
# Use a Google service account JSON with Calendar API enabled.
# Either set the full JSON string below or provide the email + private key
# details separately.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=primary

# Optional "Continue with Google" sign-in/sign-up, separate from the calendar
# write-back above. This is an OAuth 2.0 "Web application" client id from
# https://console.cloud.google.com/apis/credentials (same Google Cloud
# project is fine) — not a secret, no client secret is needed for this flow.
# Add your site's URL (and http://localhost:3000 for local dev) under
# "Authorized JavaScript origins" on that client. Leave blank to not offer
# Google sign-in at all — the email/password forms work either way.
GOOGLE_CLIENT_ID=
